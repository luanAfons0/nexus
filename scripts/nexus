#!/usr/bin/env bash

_nexus_source_libraries() {
  local SCRIPT_DIR
  SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
  source "$SCRIPT_DIR/lib/common.sh"
  source "$SCRIPT_DIR/lib/lock.sh"
  source "$SCRIPT_DIR/lib/custom.sh"
  source "$SCRIPT_DIR/lib/link.sh"
  source "$SCRIPT_DIR/lib/setup.sh"
  source "$SCRIPT_DIR/lib/upstream.sh"
  source "$SCRIPT_DIR/lib/install.sh"
  source "$SCRIPT_DIR/lib/new.sh"
  source "$SCRIPT_DIR/lib/update.sh"
  source "$SCRIPT_DIR/lib/remove.sh"
  source "$SCRIPT_DIR/lib/list.sh"
}
_nexus_source_libraries
unset -f _nexus_source_libraries

usage() {
  help_text
}

main() {
  local command="${1:-}"
  case "$command" in
    bootstrap)
      [[ "$#" -eq 1 ]] || { usage >&2; return 2; }
      bootstrap ;;
    setup)
      [[ "$#" -eq 1 ]] || { usage >&2; return 2; }
      setup ;;
    install)
      install "${@:2}" ;;
    new)
      new_skill "${@:2}" ;;
    update)
      update_skill "${@:2}" ;;
    remove)
      remove_skill "${@:2}" ;;
    list)
      [[ "$#" -eq 1 ]] || { usage >&2; return 2; }
      list_skills ;;
    link)
      [[ "$#" -eq 1 ]] || { usage >&2; return 2; }
      link_all false ;;
    help|-h|--help)
      [[ "$#" -eq 1 ]] || { usage >&2; return 2; }
      help_text ;;
    *)
      usage >&2
      return 2 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  set -uo pipefail
  nexus_init
  main "$@"
fi
